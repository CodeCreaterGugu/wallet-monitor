{
  "name": "openclaw-plugin-wallet-monitor",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "prebuild": "node scripts/gen-manifests.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "typebox": "1.3.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4"
    }
  },
  "license": "MIT"
}